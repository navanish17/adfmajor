{
	"name": "sqltoadls",
	"properties": {
		"activities": [
			{
				"name": "oldwatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT last_watermark_value\nFROM dbo.pipeline_watermark\nWHERE source_table_name = 'retail_customers_source'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "datasql",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "newwatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "oldwatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(<watermarkColumn>) AS new_watermark_value\nFROM <schemaName>.<sourceTableName>;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "datasql",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "newwatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n  'SELECT * FROM ',\n  pipeline().parameters.sourceSchemaName,\n  '.',\n  pipeline().parameters.sourceTableName,\n  ' WHERE ',\n  pipeline().parameters.watermarkColumn,\n  ' > ''',\n  activity('oldwatermark').output.firstRow.last_watermark_value,\n  ''' AND ',\n  pipeline().parameters.watermarkColumn,\n  ' <= ''',\n  activity('newwatermark').output.firstRow.new_watermark_value,\n  ''''\n)\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "datasql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "adls",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Script1",
				"type": "Script",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "sqlservice",
					"type": "LinkedServiceReference",
					"parameters": {
						"ServerName": "adfmajor678.database.windows.net",
						"DatabaseName": "adfmajor345",
						"UserName": "sqladmin"
					}
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat(\n  'UPDATE dbo.pipeline_watermark SET last_watermark_value = ''',\n  activity('newwatermark').output.firstRow.new_watermark_value,\n  ''' WHERE source_table_name = ''',\n  pipeline().parameters.sourceTableName,\n  ''''\n)\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Notebook1",
				"type": "DatabricksNotebook",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Script1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"sourceSchemaName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"sourceTableName": {
				"type": "string",
				"defaultValue": "retail_customers_source"
			},
			"watermarkColumn": {
				"type": "string",
				"defaultValue": "updated_at"
			},
			"ServerName": {
				"type": "string",
				"defaultValue": "adfmajor678.database.windows.net"
			},
			"DatabaseName": {
				"type": "string",
				"defaultValue": "adfmajor345"
			},
			"UserName": {
				"type": "string",
				"defaultValue": "sqladmin"
			}
		},
		"annotations": []
	}
}