{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfmajorassignment23"
		},
		"adlservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dsadls4567.dfs.core.windows.net"
		},
		"keyforall_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyforall3456.vault.azure.net/"
		},
		"sqlservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"sqlservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"sqlservice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "@{linkedService().UserName}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfmajorassignment23_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"keyforall_properties_typeProperties_baseUrl": {
						"value": "[parameters('keyforall_properties_typeProperties_baseUrl')]"
					},
					"adlservice_properties_typeProperties_url": {
						"value": "[parameters('adlservice_properties_typeProperties_url')]"
					},
					"sqlservice_properties_typeProperties_server": {
						"value": "[parameters('sqlservice_properties_typeProperties_server')]"
					},
					"sqlservice_properties_typeProperties_database": {
						"value": "[parameters('sqlservice_properties_typeProperties_database')]"
					},
					"sqlservice_properties_typeProperties_userName": {
						"value": "[parameters('sqlservice_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}